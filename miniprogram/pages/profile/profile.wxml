<!--我的页面-->
<view class="page">
  <view class="page-title">我的</view>

  <!--用户信息-->
  <view class="bp-card">
    <view class="flex items-center">
      <view class="avatar-box">
        <image wx:if="{{userInfo.avatar_url}}" class="avatar-img" src="{{userInfo.avatar_url}}" />
        <view wx:else class="avatar-placeholder">A</view>
      </view>
      <view class="ml-sm">
        <view class="text-lg text-bold">{{userInfo.nickname || '架构师学员'}}</view>
        <view class="text-sm text-gray mt-sm">AI生成配额: {{userInfo.quota_remaining || 0}} 次</view>
      </view>
    </view>
  </view>

  <!--学习统计-->
  <view class="bp-card">
    <view class="bp-card-title">/ 学习统计</view>
    <view class="flex justify-between mt-md">
      <view class="text-center flex-1">
        <view class="text-xl text-bold">{{stats.total_practiced || 0}}</view>
        <view class="text-sm text-gray">已练习</view>
      </view>
      <view class="text-center flex-1">
        <view class="text-xl text-bold text-blue">{{stats.accuracy || 0}}%</view>
        <view class="text-sm text-gray">正确率</view>
      </view>
      <view class="text-center flex-1">
        <view class="text-xl text-bold">{{stats.bank_count || 0}}</view>
        <view class="text-sm text-gray">题库数</view>
      </view>
    </view>
  </view>

  <!--功能入口-->
  <view class="bp-card">
    <view class="bp-card-title">/ 功能</view>

    <view class="menu-item" bindtap="goTo" data-url="/pages/bank/bank">
      <text>我的题库</text>
      <text class="text-gray">></text>
    </view>
    <view class="divider-thin"></view>

    <view class="menu-item" bindtap="goTo" data-url="/pages/wrong/wrong">
      <text>错题本</text>
      <text class="text-gray">></text>
    </view>
    <view class="divider-thin"></view>

    <view class="menu-item" bindtap="goToFavorites">
      <text>收藏夹</text>
      <text class="text-gray">></text>
    </view>
    <view class="divider-thin"></view>

    <view class="menu-item">
      <text>设置</text>
      <text class="text-gray">></text>
    </view>
  </view>

  <!--考试信息-->
  <view class="bp-card">
    <view class="bp-card-title">/ 考试信息</view>
    <view class="text-sm text-gray mt-sm" style="line-height: 2;">
      考试名称：系统架构设计师（高级）\n
      考试科目：综合知识 + 案例分析 + 论文\n
      合格标准：每科≥45分\n
      考试时间：每年11月
    </view>
  </view>
</view>
