.case-item {
  padding: 20rpx 0;
}

.case-checkbox {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid #000000;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.case-checkbox-checked {
  background-color: #000000;
  color: #FFFFFF;
}

.case-checkbox-locked {
  background-color: #2563EB;
  border-color: #2563EB;
  color: #FFFFFF;
}

.case-preview {
  color: #666666;
  line-height: 1.5;
}

.case-bg {
  line-height: 1.8;
  text-indent: 2em;
}
