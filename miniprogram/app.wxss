/* 全局样式 - 工程蓝图风格 */

page {
  font-family: 'Courier New', 'SF Mono', 'Menlo', monospace;
  background-color: #FFFFFF;
  color: #000000;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 重置 */
view, text, navigator {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* 页面容器 */
.page {
  padding: 30rpx;
  padding-bottom: 120rpx;
}

/* 页面标题 */
.page-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  padding-bottom: 20rpx;
  border-bottom: 4rpx solid #000000;
  margin-bottom: 40rpx;
}

/* 分割线 */
.divider {
  height: 2rpx;
  background-color: #000000;
  margin: 30rpx 0;
}

.divider-thin {
  height: 1rpx;
  background-color: #000000;
  margin: 20rpx 0;
}

/* 蓝图卡片 */
.bp-card {
  border: 2rpx solid #000000;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.bp-card-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #000000;
}

/* 蓝图按钮 */
.bp-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #000000;
  background-color: #FFFFFF;
  color: #000000;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  font-family: inherit;
  letter-spacing: 2rpx;
  line-height: 1;
}

.bp-btn::after {
  border: none;
}

.bp-btn-primary {
  background-color: #000000;
  color: #FFFFFF;
}

.bp-btn-blue {
  border-color: #2563EB;
  color: #2563EB;
}

.bp-btn-blue.bp-btn-primary {
  background-color: #2563EB;
  color: #FFFFFF;
  border-color: #2563EB;
}

.bp-btn-danger {
  border-color: #DC2626;
  color: #DC2626;
}

.bp-btn-block {
  display: flex;
  width: 100%;
}

.bp-btn-sm {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}

.bp-btn-lg {
  padding: 24rpx 48rpx;
  font-size: 32rpx;
}

/* 蓝图输入框 */
.bp-input {
  border: none;
  border-bottom: 2rpx solid #000000;
  padding: 16rpx 0;
  font-size: 28rpx;
  font-family: inherit;
  width: 100%;
  background: transparent;
}

.bp-input-box {
  border: 2rpx solid #000000;
  padding: 16rpx;
  font-size: 28rpx;
  font-family: inherit;
  width: 100%;
  background: transparent;
}

.bp-textarea {
  border: 2rpx solid #000000;
  padding: 16rpx;
  font-size: 28rpx;
  font-family: inherit;
  width: 100%;
  min-height: 200rpx;
  background: transparent;
}

/* 蓝图标签 */
.bp-tag {
  display: inline-flex;
  border: 1rpx solid #000000;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.bp-tag-active {
  background-color: #000000;
  color: #FFFFFF;
}

.bp-tag-blue {
  border-color: #2563EB;
  color: #2563EB;
}

.bp-tag-blue.bp-tag-active {
  background-color: #2563EB;
  color: #FFFFFF;
}

/* 蓝图进度条 */
.bp-progress {
  border: 2rpx solid #000000;
  height: 24rpx;
  position: relative;
}

.bp-progress-bar {
  height: 100%;
  background-color: #000000;
  transition: width 0.3s;
}

.bp-progress-blue .bp-progress-bar {
  background-color: #2563EB;
}

/* 网格布局 */
.bp-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -12rpx;
}

.bp-grid-item {
  padding: 12rpx;
}

.bp-grid-2 .bp-grid-item {
  width: 50%;
}

.bp-grid-3 .bp-grid-item {
  width: 33.33%;
}

.bp-grid-4 .bp-grid-item {
  width: 25%;
}

/* Flex工具类 */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.flex-1 { flex: 1; }

/* 间距工具类 */
.mt-sm { margin-top: 16rpx; }
.mt-md { margin-top: 24rpx; }
.mt-lg { margin-top: 40rpx; }
.mb-sm { margin-bottom: 16rpx; }
.mb-md { margin-bottom: 24rpx; }
.mb-lg { margin-bottom: 40rpx; }
.mr-sm { margin-right: 16rpx; }
.ml-sm { margin-left: 16rpx; }
.p-sm { padding: 16rpx; }
.p-md { padding: 24rpx; }

/* 文字工具类 */
.text-center { text-align: center; }
.text-right { text-align: right; }
.text-sm { font-size: 24rpx; }
.text-md { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 40rpx; }
.text-2xl { font-size: 48rpx; }
.text-bold { font-weight: 700; }
.text-blue { color: #2563EB; }
.text-red { color: #DC2626; }
.text-gray { color: #666666; }

/* 答案状态 */
.answer-correct {
  border-color: #2563EB !important;
  color: #2563EB !important;
}

.answer-wrong {
  border-color: #DC2626 !important;
  color: #DC2626 !important;
}

/* 答题卡格子 */
.answer-grid {
  display: flex;
  flex-wrap: wrap;
}

.answer-cell {
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid #000000;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 6rpx;
  font-size: 24rpx;
}

.answer-cell-done {
  background-color: #000000;
  color: #FFFFFF;
}

.answer-cell-current {
  border-width: 3rpx;
  border-color: #2563EB;
}

/* 底部悬浮栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  border-top: 2rpx solid #000000;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

/* 加载中 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #666666;
  font-size: 24rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999999;
}

.empty-text {
  font-size: 28rpx;
  margin-top: 20rpx;
}
